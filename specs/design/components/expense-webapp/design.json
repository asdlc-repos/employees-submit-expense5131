{
  "name": "expense-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "expense-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.3",
    "F1.4",
    "F1.5",
    "F1.6",
    "F1.7",
    "F2.1",
    "F2.2",
    "F2.3",
    "F2.4",
    "F2.7",
    "F3.1",
    "F3.2",
    "F3.3",
    "F3.4"
  ],
  "description": "The one browser app for employees, managers and finance. Each role sees its own screens: my claims and the claim form, the approvals queue and claim review, the payroll export, and the people list. It calls expense-api with the signed-in user's token and holds no data of its own; it does not talk to storage or email directly.",
  "dependencies": [
    {
      "kind": "component",
      "name": "expense-api",
      "description": "Loads and changes claims, approvals, exports and people.",
      "wiring": {
        "endpoint": {
          "component": "employees-submit-expense5131-expense-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "EXPENSE_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "description": "Signs users in with SSO.",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "employees-submit-b0e20023",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
