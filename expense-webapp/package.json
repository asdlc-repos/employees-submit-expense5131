{
  "name": "expense-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "gen": "node scripts/gen-authz.mjs",
    "gen:api": "openapi-typescript ../specs/design/components/expense-api/openapi.yaml -o src/generated/expense-api.ts",
    "build": "npm run gen && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@wso2/oxygen-ui": "^0.16.0",
    "@wso2/oxygen-ui-icons-react": "^0.16.0",
    "oidc-client-ts": "^3.5.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "yaml": "^2.9.1"
  }
}
